# ── Self-hosted (VPS) configuration — no Supabase ──
# PostgreSQL connection used by the Next.js server (role "authenticator", see deploy/00_bootstrap.sql)
DATABASE_URL=postgres://authenticator:CHANGE-ME@127.0.0.1:5432/hm_maths
# PostgREST (local only, never exposed publicly)
POSTGREST_URL=http://127.0.0.1:3001
# Shared HS256 secret for session tokens + PostgREST (min 32 chars). Changing it signs everyone out.
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
# Where uploaded files (slips, tutes, papers, banners) are stored
STORAGE_DIR=/srv/hm-maths/storage
NEXT_PUBLIC_SITE_URL=https://hm.nativelaunch.xyz
# Optional: secret for the sign-up maths captcha (falls back to JWT_SECRET)
CAPTCHA_SECRET=
# Set to 1 only when serving over plain http (no TLS), otherwise login cookies are not stored
COOKIE_INSECURE=
